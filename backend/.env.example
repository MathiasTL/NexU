# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-secreto-seguro-de-64-hex-chars

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Servidor ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ── Storage (para upload de imágenes) ────────────────────────────────────────
# Opciones: "memory" | "s3" | "gcs"
STORAGE_BACKEND=memory

# Cuando STORAGE_BACKEND=s3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=nexu-images
# AWS_REGION=us-east-1

# Cuando STORAGE_BACKEND=gcs:
# GCS_BUCKET=nexu-images
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# ── LLM / IA de matching (Groq, free tier — API compatible con OpenAI) ────────
# Dos API keys independientes para repartir el rate limit de Groq entre los dos
# dominios de matching. Vacío = degradación a explicación por plantilla en ese
# dominio (el matching nunca se cae). Obtén keys gratis en https://console.groq.com
#
# Roommates (compat: también se aceptan los nombres antiguos LLM_API_KEY / GROQ_API_KEY):
LLM_API_KEY_ROOMMATES=
# Habitaciones (rooms). Si se deja vacío, cae a la key de roommates:
LLM_API_KEY_ROOMS=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
