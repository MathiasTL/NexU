# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-secreto-seguro-de-64-hex-chars

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Servidor ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ── Storage (para upload de imágenes) ────────────────────────────────────────
# Opciones: "memory" | "s3" | "gcs"
STORAGE_BACKEND=memory

# Cuando STORAGE_BACKEND=s3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=nexu-images
# AWS_REGION=us-east-1

# Cuando STORAGE_BACKEND=gcs:
# GCS_BUCKET=nexu-images
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
